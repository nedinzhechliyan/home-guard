# =============================================================================
# Home Guard - Environment Configuration
# =============================================================================

# Smart Home Device Backend Provider ('lifx' or 'homeassistant')
DEVICE_PROVIDER="lifx"

# LIFX HTTP API Token (from https://cloud.lifx.com/settings)
LIFX_TOKEN="c1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"

# Home Assistant (used if DEVICE_PROVIDER=homeassistant)
HA_URL="https://homeassistant.local:8123"
HA_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Dev Static Token (For local console testing only; leave blank in production)
# WARNING: Disable in production. Cognito JWTs are enforced if blank.
DEV_STATIC_TOKEN="local-dev-static-secret"

# AWS Serverless Stack Configuration (Populated automatically by AWS SAM)
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_example"
COGNITO_CLIENT_ID="1234567890abcdefghij"
LEDGER_TABLE_NAME="HomeGuardLedger"
SCHEDULES_TABLE_NAME="HomeGuardSchedules"
SCHEDULER_ROLE_ARN="arn:aws:iam::123456789012:role/HomeGuardSchedulerRole"
EXECUTOR_LAMBDA_ARN="arn:aws:lambda:us-east-1:123456789012:function:HomeGuardExecutor"

# Frontend Web Console (injected into memory via Settings drawer)
# MCP_URL: e.g. https://abc123xyz.execute-api.us-east-1.amazonaws.com/mcp or http://localhost:8000/mcp
